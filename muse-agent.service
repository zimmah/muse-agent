[Unit]
Description=Muse research agent daemon
After=network-online.target ollama.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/Workspace/Github/zimmah/msc-muse
ExecStart=%h/.nvm/versions/node/v25.9.0/bin/node agent.ts run
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
